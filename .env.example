# Copy to .env and fill in. Never commit .env.
APP_ENV=dev                      # dev | test | staging | prod
LOG_LEVEL=INFO

# Docker compose injects these. Postgres and Redis are not published to the host;
# services reach them on the internal network as postgres:5432 and redis:6379.
DATABASE_URL=postgresql+asyncpg://gateway:gateway@postgres:5432/gateway
REDIS_URL=redis://redis:6379/0

# Fernet key for bot/webhook secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=

# Plan section 3.1: dev/test only. The app refuses to start in prod/staging with these on.
ALLOW_PRIVATE_BOT_URLS=true
ENABLE_MOCK_BOT=true

# Admin panel: comma-separated IPs/CIDRs allowed to open /admin (empty = any address).
# Set this in staging/prod. Behind a proxy the app must see the real client IP.
ADMIN_IP_ALLOWLIST=
ADMIN_SESSION_HOURS=8
# reject (default): X-WA-Number must match the vendor's registered number, else 403 NUMBER_MISMATCH.
# warn: only log a mismatch (local debugging only).
WA_NUMBER_MISMATCH_POLICY=reject

# Admin two-factor login (TOTP). Every admin can turn it on at /admin/account. true = an admin
# without it can only open the account page until they have set it up.
ADMIN_REQUIRE_2FA=false

# Outbound messages (Phase 2). These are the defaults, set them only to change them.
# MAX_QUEUED_JOBS_PER_VENDOR=1000   more open jobs than this: 503 QUEUE_FULL
# OUTBOUND_RATE_LIMIT_PER_MINUTE=600
# Origins the extension may open the socket from (comma-separated). Empty = do not check Origin;
# the API key is the real protection. Example: chrome-extension://<your extension id>
SOCKET_ALLOWED_ORIGINS=
